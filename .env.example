# mona.expert — Environment Configuration Example
# Copy to .env and customize:
#   cp .env.example .env
#
# Docker Compose users: these values are also used by docker-compose.yml

# ─── Server Ports ─────────────────────────────
# Public website gateway
MONA_EXPERT_PORT=4188
# Internal mTLS wrapper backend
WRAPPER_PORT=4189
# Dashboard (optional)
DASHBOARD_PORT=4177

# ─── MySQL Database ───────────────────────────
# Set MYSQL_HOST to "mysql" when using Docker Compose
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mona
MYSQL_PASSWORD=mona_password
MYSQL_DATABASE=mona_expert
MYSQL_ROOT_PASSWORD=mona_root_secret

# ─── LLM Providers ────────────────────────────
# At least one provider key is needed for LLM proxy
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama local (no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=

# ─── Agent Config ─────────────────────────────
# Where installed agents live (uses .mona-agents in project dir by default)
# MONA_AGENTS_DIR=./.mona-agents

# ─── TLS / Certs ──────────────────────────────
# Generated by install.sh — point at your certs directory
# CERTS_DIR=./certs

# ─── FTP (deployment uploads) ──────────────────────
# Required by bin/upload*.js — NEVER hardcode in source
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# FTP_PORT=21
# FTP_SECURE=false

# ─── Default Tenant ───────────────────────────
DEFAULT_TENANT=default

# ─── Production Settings ──────────────────────
# NODE_ENV=production
# LOG_LEVEL=info
